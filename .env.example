# Local configuration. Copy to `.env` and fill in values.
# Never commit `.env`. Production builds use GitHub Environment / Actions secrets.
#
# The desktop app loads `.env` from the repo root (or shuttle-app/) at startup
# without overwriting variables already set in the process environment.

# ---------------------------------------------------------------------------
# Telemetry (testing projects only — never mix with production)
# ---------------------------------------------------------------------------

# Sentry DSN — testing project only
SENTRY_DSN=

# PostHog project API key — testing project only
POSTHOG_API_KEY=

# PostHog ingest host (US cloud default; EU is https://eu.i.posthog.com)
POSTHOG_HOST=https://us.i.posthog.com

# testing | production  (local must stay testing)
SHUTTLE_BUILD_CHANNEL=testing

# Optional git SHA attached to telemetry
SHUTTLE_GIT_COMMIT=

# ---------------------------------------------------------------------------
# Lazy connector downloads (baked into release builds)
# ---------------------------------------------------------------------------

# Public base URL of the S3-compatible component bucket (no trailing slash).
# The app fetches `{SHUTTLE_COMPONENTS_BASE_URL}/v{app_version}/manifest.json`
# Set this when running `tauri build` so it is compiled in.
# Example: https://cdn.example.com/shuttle/components
SHUTTLE_COMPONENTS_BASE_URL=

# ---------------------------------------------------------------------------
# Local runtime overrides
# ---------------------------------------------------------------------------

# App data directory (default: OS app-data / shuttle)
# SHUTTLE_DATA_DIR=

# Media / files directory used by sidecars
# SHUTTLE_FILES_DIR=

# Python interpreter. Unset = managed runtime, then system Python 3.12+
# SHUTTLE_PYTHON=

# Native helper binaries (skip lazy download / use a local copy)
# SHUTTLE_GOWA_BIN=
# SHUTTLE_TDLIB=
# SHUTTLE_SIGNAL_CLI=

# Seed demo conversations on first launch (1 = yes)
# SHUTTLE_SEED_DEMO=0

# Vite HMR host for `tauri dev` on a remote/WSL display
# TAURI_DEV_HOST=

# ---------------------------------------------------------------------------
# Frontend features (Vite — only available in the UI layer, not Rust)
# ---------------------------------------------------------------------------

# Giphy API key — enables GIF/sticker search in the composer (optional)
# Local: set here. CI: add as GitHub Environment secret VITE_GIPHY_API_KEY on release builds.
# Get a free key at https://developers.giphy.com/
# VITE_GIPHY_API_KEY=

# ---------------------------------------------------------------------------
# Connector-specific (optional; UI credentials take precedence)
# ---------------------------------------------------------------------------

# Point WhatsApp at an already-running GOWA instance (loopback only)
# SHUTTLE_GOWA_URL=
# SHUTTLE_GOWA_USER=
# SHUTTLE_GOWA_PASSWORD=

# Telegram TDLib credentials from https://my.telegram.org
# SHUTTLE_TELEGRAM_API_ID=
# SHUTTLE_TELEGRAM_API_HASH=

# ---------------------------------------------------------------------------
# Component publish (maintainers: ./scripts/publish-components.sh)
# ---------------------------------------------------------------------------

# Output directory for staged archives (default: dist/components)
# SHUTTLE_COMPONENTS_OUT=

# Version path under the bucket (default: shuttle-app/package.json version)
# SHUTTLE_COMPONENTS_VERSION=

# Force a platform key instead of detecting the host
# linux-x86_64 | linux-arm64 | macos-x86_64 | macos-arm64 | windows-x86_64 | windows-arm64
# SHUTTLE_COMPONENTS_PLATFORM=

# Standalone Python fetch (./scripts/fetch-python-runtime.sh)
# SHUTTLE_PYTHON_TRIPLE=
# SHUTTLE_PYTHON_SKIP_DEPS=0
# SHUTTLE_FORCE_PYTHON_FETCH=0

# Cross-fetch signal-cli for another OS/arch (./connectors/signal/fetch.sh)
# SHUTTLE_SIGNAL_OS=
# SHUTTLE_SIGNAL_ARCH=

# S3-compatible upload (CI secrets; also usable locally with awscli)
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=
# S3_REGION=auto
