# Local / testing telemetry. Copy to `.env` and fill in values.
# Never commit `.env`. Production builds use GitHub Environment secrets instead.
#
# Use a *testing* Sentry project DSN and PostHog project key here so local
# crashes/events never mix with production.

# Sentry DSN — testing project only
SENTRY_DSN=

# PostHog project API key — testing project only
POSTHOG_API_KEY=

# PostHog ingest host (US cloud default; EU is https://eu.i.posthog.com)
POSTHOG_HOST=https://us.i.posthog.com

# testing | production  (local must stay testing)
SHUTTLE_BUILD_CHANNEL=testing

# Optional git SHA attached to telemetry
SHUTTLE_GIT_COMMIT=
