<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Tauri merges this file into the bundle's Info.plist. macOS 12 and later hand a WKWebView
       microphone capture request to the app process, and the OS prompt cannot appear without a
       usage description: without this key the process is killed the first time it asks. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Shuttle uses the microphone to record voice notes.</string>
</dict>
</plist>
