<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Applied by codesign when the bundle is signed. The hardened runtime blocks the
       microphone without this entitlement, so the voice-note recorder would fail on a signed
       build even though the Info.plist description is present. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
